@namespace SolidCP.WebPortal.Blazor.Components

<button type="button" class="p-2 rounded-lg text-gray-400 hover:text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200" 
        @onclick="ToggleTheme" aria-label="Toggle theme">
    @if (IsDark)
    {
        <!-- Sun icon for dark mode -->
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
    }
    else
    {
        <!-- Moon icon for light mode -->
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
    }
</button>

@code {
    [Parameter] public bool IsDark { get; set; }
    [Parameter] public EventCallback<bool> OnThemeChanged { get; set; }

    protected override void OnInitialized()
    {
        // Check localStorage or system preference on initialization
        var storedTheme = GetStoredTheme();
        if (!string.IsNullOrEmpty(storedTheme))
        {
            IsDark = storedTheme == "dark";
        }
        else
        {
            // Default to system preference
            IsDark = IsSystemPreferenceDark();
        }
        
        ApplyTheme();
    }

    private async Task ToggleTheme()
    {
        IsDark = !IsDark;
        await ApplyTheme();
        await OnThemeChanged.InvokeAsync(IsDark);
    }

    private async Task ApplyTheme()
    {
        // Apply theme to document
        if (IsDark)
        {
            await JSRuntime.InvokeVoidAsync("themeManager.setDark");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("themeManager.setLight");
        }
    }

    private bool IsSystemPreferenceDark()
    {
        // This would need to be checked on the client side
        // For now, default to false (light mode)
        return false;
    }

    private string? GetStoredTheme()
    {
        // This would need to read from localStorage
        // For now, return null to use default
        return null;
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
}