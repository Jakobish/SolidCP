@page "/"
@using Sysinfocus.AspNetCore.Components
@using SolidCP.WebPortal.Blazor

<PageTitle>SolidCP Dashboard</PageTitle>

<div class="space-y-6">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Welcome to SolidCP</h1>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Modern hosting control panel with updated UI components
            </p>
        </div>
        <div class="mt-4 sm:mt-0 flex space-x-3">
            <UiButton Variant="primary" OnClick="ShowNotification">
                <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Add New
            </UiButton>
            <UiButton Variant="secondary" OnClick="ShowModal">
                <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z" />
                </svg>
                Share
            </UiButton>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <UiCard>
            <div class="flex items-center">
                <div class="shrink-0">
                    <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                </div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Total Servers</dt>
                        <dd class="text-lg font-medium text-gray-900 dark:text-gray-100">24</dd>
                    </dl>
                </div>
            </div>
        </UiCard>

        <UiCard>
            <div class="flex items-center">
                <div class="shrink-0">
                    <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                    </svg>
                </div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Active Domains</dt>
                        <dd class="text-lg font-medium text-gray-900 dark:text-gray-100">156</dd>
                    </dl>
                </div>
            </div>
        </UiCard>

        <UiCard>
            <div class="flex items-center">
                <div class="shrink-0">
                    <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                    </svg>
                </div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">User Accounts</dt>
                        <dd class="text-lg font-medium text-gray-900 dark:text-gray-100">1,234</dd>
                    </dl>
                </div>
            </div>
        </UiCard>

        <UiCard>
            <div class="flex items-center">
                <div class="shrink-0">
                    <svg class="h-6 w-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" />
                    </svg>
                </div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Storage Used</dt>
                        <dd class="text-lg font-medium text-gray-900 dark:text-gray-100">2.4 TB</dd>
                    </dl>
                </div>
            </div>
        </UiCard>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <!-- Recent Activity -->
        <div class="lg:col-span-2">
            <UiCard Title="Recent Activity" DescriptionText="Latest actions and events in your system">
                <div class="space-y-4">
                    @foreach (var activity in RecentActivities)
                    {
                        <div class="flex items-center space-x-3 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                            <div class="shrink-0">
                                @switch (activity.Type)
                                {
                                    case "server":
                                        <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
                                            </svg>
                                        </div>
                                        break;
                                    case "domain":
                                        <div class="w-8 h-8 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                                            </svg>
                                        </div>
                                        break;
                                    case "user":
                                        <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-purple-600 dark:text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                                            </svg>
                                        </div>
                                        break;
                                }
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-gray-900 dark:text-gray-100">@activity.Title</p>
                                <p class="text-sm text-gray-500 dark:text-gray-400">@activity.Description</p>
                            </div>
                            <div class="text-xs text-gray-400 dark:text-gray-500">@activity.Time</div>
                        </div>
                    }
                </div>
            </UiCard>
        </div>

        <!-- Quick Actions -->
        <div>
            <UiCard Title="Quick Actions">
                <div class="space-y-3">
                    <UiButton Variant="primary" Class="w-full justify-start">
                        <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                        Add Server
                    </UiButton>
                    <UiButton Variant="secondary" Class="w-full justify-start">
                        <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                        </svg>
                        Register Domain
                    </UiButton>
                    <UiButton Variant="secondary" Class="w-full justify-start">
                        <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        Create User
                    </UiButton>
                    <UiButton Variant="danger" Class="w-full justify-start">
                        <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        Backup
                    </UiButton>
                </div>
            </UiCard>
        </div>
    </div>

    <!-- Sample Table -->
    <UiCard Title="System Overview">
        <UiTable Items="SampleData" Columns="TableColumns" ShowPagination="true" TotalItems="100" PageSize="10" />
    </UiCard>

    <!-- Demo Form -->
    <UiCard Title="Form Components Demo">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <UiInput Label="Server Name" Placeholder="Enter server name" Required="true" />
            <UiInput Label="IP Address" Placeholder="192.168.1.1" LeftIcon="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            <UiInput Label="Description" Placeholder="Server description" Class="sm:col-span-2" />
            <UiInput Label="Storage" Type="number" Placeholder="100" HelpText="Storage in GB" />
            <UiInput Label="Monthly Cost" Type="number" Placeholder="99.99" HelpText="Cost in USD" />
        </div>
        <div class="mt-6 flex justify-end space-x-3">
            <UiButton Variant="ghost">Cancel</UiButton>
            <UiButton Variant="primary">Save Server</UiButton>
        </div>
    </UiCard>
</div>

<!-- Demo Modal -->
<UiModal Show="ShowModalDialog" Title="Demo Modal" DescriptionText="This is a demonstration of the modal component">
    <Body>
        <p class="text-sm text-gray-500 dark:text-gray-400">
            This modal demonstrates the new SolidCP UI component system with proper dark mode support and accessibility features.
        </p>
    </Body>
    <Footer>
        <div class="flex justify-end space-x-3">
            <UiButton Variant="ghost" OnClick="() => ShowModalDialog = false">Cancel</UiButton>
            <UiButton Variant="primary" OnClick="() => ShowModalDialog = false">Confirm</UiButton>
        </div>
    </Footer>
</UiModal>

<!-- Demo Notification -->
<UiNotification Show="ShowNotificationDialog" Type="UiNotification.NotificationType.Success" Title="Action Completed" Message="Your changes have been saved successfully!" />

@code {
    private bool ShowModalDialog = false;
    private bool ShowNotificationDialog = false;

    private List<Activity> RecentActivities = new()
    {
        new Activity { Type = "server", Title = "Server 'PROD-01' restarted", Description = "Maintenance window completed", Time = "2 minutes ago" },
        new Activity { Type = "domain", Title = "Domain 'example.com' renewed", Description = "Auto-renewal successful", Time = "1 hour ago" },
        new Activity { Type = "user", Title = "New user account created", Description = "john.doe@example.com", Time = "3 hours ago" },
        new Activity { Type = "server", Title = "Backup completed", Description = "Nightly backup for all servers", Time = "6 hours ago" }
    };

    private List<ServerInfo> SampleData = Enumerable.Range(1, 10).Select(i => new ServerInfo
    {
        Id = i,
        Name = $"Server-{i:D3}",
        Ip = $"192.168.1.{i}",
        Status = i % 4 == 0 ? "Active" : i % 3 == 0 ? "Warning" : "Online",
        LastBackup = DateTime.Now.AddDays(-i),
        Storage = i * 100 + " GB"
    }).ToList();

    private List<UiTable.TableColumn> TableColumns = new()
    {
        new UiTable.TableColumn { Title = "ID", PropertyName = "Id", Format = "number" },
        new UiTable.TableColumn { Title = "Server Name", PropertyName = "Name" },
        new UiTable.TableColumn { Title = "IP Address", PropertyName = "Ip" },
        new UiTable.TableColumn { Title = "Status", PropertyName = "Status" },
        new UiTable.TableColumn { Title = "Storage", PropertyName = "Storage" },
        new UiTable.TableColumn { Title = "Last Backup", PropertyName = "LastBackup", Format = "date" }
    };

    private void ShowModal()
    {
        ShowModalDialog = true;
    }

    private void ShowNotification()
    {
        ShowNotificationDialog = true;
        StateHasChanged();
    }

    public class Activity
    {
        public string Type { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Time { get; set; } = "";
    }

    public class ServerInfo
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Ip { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime LastBackup { get; set; }
        public string Storage { get; set; } = "";
    }
}
