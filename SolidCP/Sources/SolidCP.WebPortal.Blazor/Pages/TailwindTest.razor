@page "/tailwind-test"

<div class="p-10 bg-gray-100 min-h-screen space-y-8">
    
    <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Design System Components</h2>

        <!-- Card Example -->
        <UiCard Class="mb-8">
            <Header>
                <h3 class="text-lg leading-6 font-medium text-gray-900">Card Component</h3>
                <p class="mt-1 max-w-2xl text-sm text-gray-500">This is a reusable card component.</p>
            </Header>
            <ChildContent>
                <p class="text-gray-700">
                    This content is inside the card body. The card handles padding, shadows, and rounded corners automatically.
                </p>
                <div class="mt-4 flex space-x-4">
                    <UiButton Variant="primary">Primary Action</UiButton>
                    <UiButton Variant="secondary">Secondary Action</UiButton>
                    <UiButton Variant="danger">Danger Action</UiButton>
                    <UiButton Variant="ghost">Ghost Action</UiButton>
                </div>
            </ChildContent>
            <Footer>
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-500">Last updated: Just now</span>
                    <UiButton Variant="primary" IsLoading="true">Loading State</UiButton>
                </div>
            </Footer>
        </UiCard>

        <!-- Original Test -->
        <UiCard>
            <ChildContent>
                <div class="md:flex">
                    <div class="md:shrink-0">
                        <div class="h-48 w-full object-cover md:h-full md:w-48 bg-indigo-500 flex items-center justify-center text-white text-4xl font-bold rounded-md">
                            UI
                        </div>
                    </div>
                    <div class="p-8">
                        <div class="uppercase tracking-wide text-sm text-indigo-500 font-semibold">Tailwind CSS Test</div>
                        <a href="#" class="block mt-1 text-lg leading-tight font-medium text-black hover:underline">Checking if Tailwind is working</a>
                        <p class="mt-2 text-slate-500">If you see this card styled correctly with a shadow, rounded corners, and responsive layout, then Tailwind CSS is successfully integrated into the Blazor project!</p>
                    </div>
                </div>
            </ChildContent>
        </UiCard>

    </div>
</div>
